{
  "name": "throttlkit",
  "version": "0.1.1",
  "description": "In-process and PostgreSQL-backed rate limiting for Node.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/throttlkit/throttlkit.git"
  },
  "bugs": "https://github.com/throttlkit/throttlkit/issues",
  "homepage": "https://github.com/throttlkit/throttlkit#readme",
  "keywords": [
    "rate-limit",
    "throttle",
    "sliding-window",
    "token-bucket",
    "postgresql"
  ],
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src/",
    "README.md",
    "BENCHMARK.md",
    "benchmark.js",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/throttle.test.js test/express.test.js",
    "benchmark": "node --expose-gc benchmark.js",
    "test:types": "tsc --noEmit --project test/tsconfig.json",
    "test:integration": "node --test test/postgres.test.js"
  },
  "peerDependencies": {
    "pg": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/pg": "^8.23.1",
    "express": "^5.1.0",
    "pg": "^8.16.3",
    "supertest": "^7.1.4",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
