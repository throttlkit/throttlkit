{
  "name": "throttlflow",
  "version": "0.2.0",
  "description": "Weighted rate limiting with memory, Redis and PostgreSQL stores for Node.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/throttlkit/throttlkit.git"
  },
  "bugs": "https://github.com/throttlkit/throttlkit/issues",
  "homepage": "https://github.com/throttlkit/throttlkit#readme",
  "keywords": [
    "rate-limit",
    "throttle",
    "sliding-window",
    "token-bucket",
    "postgresql",
    "redis",
    "gcra",
    "middleware"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    },
    "./core": {
      "node": {
        "import": { "types": "./dist/core.d.ts", "default": "./dist/core-node.js" },
        "require": { "types": "./dist/core.d.cts", "default": "./dist/core-node.cjs" }
      },
      "import": { "types": "./dist/core.d.ts", "default": "./dist/portable.js" },
      "require": { "types": "./dist/core.d.cts", "default": "./dist/portable.cjs" }
    },
    "./migrations/*": "./migrations/*"
  },
  "files": [
    "dist/",
    "migrations/",
    "GUIDE.md",
    "aboutme.txt",
    "CHANGELOG.md",
    "RELEASING.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "examples/",
    "README.md",
    "BENCHMARK.md",
    "benchmark.js",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "prepack": "npm run build",
    "test": "node --test test/throttle.test.js test/express.test.js test/features.test.js test/adapters.test.js test/circuit.test.js",
    "test:package": "npm run build && node --test test/package.test.js",
    "test:embedded": "node --test test/embedded-stores.test.js",
    "benchmark": "npm run build && node --expose-gc benchmark.js",
    "benchmark:stores": "node scripts/benchmark-stores.js",
    "test:types": "tsc --noEmit --project test/tsconfig.json",
    "test:integration": "node --test test/postgres.test.js test/stores.test.js",
    "check": "npm test && npm run test:package && npm run test:types && npm run test:embedded && npm run test:integration"
  },
  "peerDependencies": {
    "pg": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/pg": "^8.23.1",
    "@types/node": "^22.0.0",
    "express": "^5.1.0",
    "pg": "^8.16.3",
    "supertest": "^7.1.4",
    "typescript": "^5.9.3",
    "esbuild": "^0.25.0",
    "redis": "^5.0.0",
    "fastify": "^5.0.0",
    "koa": "^3.0.0",
    "@electric-sql/pglite": "^0.3.0",
    "fengari": "^0.1.4"
  },
  "engines": {
    "node": ">=22"
  }
}
